<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     RUNTIME SETUP — LANDSCAPE VARIANT (Task 2)
     Same IDs & containers as the portrait layout (code untouched, R5):
     rs_select_container / rs_install_container visibility toggling,
     rs_card_container, rs_ring, rs_install_rows, rs_btn_* all present.

     Layout: horizontal split.
       • Left panel (38%): eyebrow + title + summary + aggregate progress
         ring + install stats (or offline note / CTA in SELECT state).
       • Right panel (62%): runtime choice cards scroll (SELECT) or the
         horizontal install-stage carousel (INSTALL).
══════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_runtime_setup_page">

    <!-- ─────────────── STATE 1: SELECTION (horizontal split) ─────────────── -->
    <LinearLayout
        android:id="@+id/rs_select_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp">

        <!-- ── Left panel: pitch + CTA (fixed 38%) ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.38"
            android:orientation="vertical"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:text="@string/rs_eyebrow"
                android:textColor="#D8C79A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/rs_title"
                android:textColor="#F0F0F3"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/rs_summary"
                android:textColor="#9C9CA8"
                android:textSize="12.5sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/rs_offline_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/rs_offline_note"
                android:textColor="#E5A0A6"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/rs_btn_install"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_install_cta_white"
                android:letterSpacing="0.08"
                android:text="@string/rs_install_cta"
                android:textColor="#0E0E11"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Install Selected (2)" />

            <TextView
                android:id="@+id/rs_btn_skip"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="@string/rs_skip"
                android:textColor="#7C7C88"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── Right panel: runtime choice cards (62%) ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.62"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rs_card_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- ─────────────── STATE 2: INSTALL DECK (horizontal split) ─────────────── -->
    <LinearLayout
        android:id="@+id/rs_install_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- ── Left panel: eyebrow + aggregate ring + install stats (38%) ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.38"
            android:orientation="vertical"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:text="@string/rs_install_eyebrow"
                android:textColor="#D8C79A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp">

                <!-- violet halo behind the aggregate ring (Req-5 loading visual) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rs_ring_halo" />

                <net.kdt.pojavlaunch.multirt.RuntimeRingView
                    android:id="@+id/rs_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/rs_overall_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#F0F0F3"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="42%" />
            </FrameLayout>

            <TextView
                android:id="@+id/rs_overall_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="#F0F0F3"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Installing Java 17…" />

            <TextView
                android:id="@+id/rs_status_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#9C9CA8"
                android:textSize="11.5sp"
                tools:text="24.1 / 55 MB • 4.2 MB/s • ~8s left" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/rs_btn_done"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_install_cta_white"
                android:letterSpacing="0.08"
                android:text="@string/rs_done_cta"
                android:textColor="#0E0E11"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- ── Right panel: install stage carousel (62%) ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.62"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:clipToPadding="false"
                    android:paddingEnd="26dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/rs_install_rows"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- edge fade hinting at more stages past the fold -->
                <View
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_rs_fade_edge"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
