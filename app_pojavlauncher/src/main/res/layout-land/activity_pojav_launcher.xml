<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@drawable/bg_premium_cosmic_gradient"
    android:id="@+id/root_container">

    <!-- ═════════════ GLASS HEADER ═════════════ -->
    <LinearLayout
        android:id="@+id/glass_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_glass_header"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo -->
        <FrameLayout
            android:id="@+id/btn_home_logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/iv_cs_logo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher_round"
                android:scaleType="fitCenter"
                android:contentDescription="CS Logo" />
        </FrameLayout>

        <!-- Title + Subtitle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_launcher_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_launcher_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.06"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/tv_launcher_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_launcher_subtitle"
                android:textSize="11sp"
                android:textColor="#A8B2D1"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Premium Nav Pills -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/nav_mod_store"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">
                <ImageView
                    android:id="@+id/nav_mod_store_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_download_box"
                    android:contentDescription="Download" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_custom_controls"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">
                <ImageView
                    android:id="@+id/nav_controls_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu_custom_controls"
                    android:contentDescription="Controls" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_cursor"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_margin="2dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">
                <ImageView
                    android:id="@+id/nav_cursor_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mouse_pointer"
                    android:contentDescription="Cursor" />
            </FrameLayout>
        </LinearLayout>

        <!-- Client Features -->
        <Button
            android:id="@+id/btn_client_features"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:text="✦"
            android:textSize="16sp"
            android:textColor="#00E5FF"
            android:background="@drawable/bg_client_features_btn"
            android:layout_gravity="center_vertical" />

        <!-- Skin -->
        <FrameLayout
            android:id="@+id/nav_skin"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/nav_skin_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_manage_skin"
                android:contentDescription="Skin" />
        </FrameLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Home -->
        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_margin="2dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_home"
                android:contentDescription="Home" />
        </FrameLayout>

        <!-- Account -->
        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="140dp"
            android:layout_height="36dp"
            android:dropDownWidth="wrap_content"
            android:dropDownVerticalOffset="40dp"
            android:background="@drawable/bg_account_spinner"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <!-- Settings -->
        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_settings_btn"
            android:src="@drawable/ic_menu_settings"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:contentDescription="Settings"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ═════════════ FRAGMENT CONTAINER ═════════════ -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="84dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/glass_header"
        app:layout_constraintBottom_toTopOf="@+id/play_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═════════════ PREMIUM PLAY CARD ═════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/play_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#12FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Profile Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILE"
                    android:textSize="11sp"
                    android:textColor="#8892B0"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/play_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default Profile"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Select profile"
                    android:tint="#00E5FF" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF"
                android:layout_marginVertical="8dp" />

            <!-- Version Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VERSION"
                    android:textSize="11sp"
                    android:textColor="#8892B0"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/play_version_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.21"
                    android:textSize="14sp"
                    android:textColor="#A8B2D1" />
            </LinearLayout>

            <!-- Play Button -->
            <Button
                android:id="@+id/play_button_main"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_card_premium"
                android:text="▶ PLAY"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#00E5FF"
                android:letterSpacing="0.12"
                android:elevation="8dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ═════════════ QUICK ACTIONS BAR ═════════════ -->
    <LinearLayout
        android:id="@+id/quick_actions_bar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_glass_bar"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/action_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_profile"
                android:tint="#A8B2D1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE"
                android:textSize="10sp"
                android:textColor="#8892B0"
                android:layout_marginTop="2dp"
                android:textAllCaps="true"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_download"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_download_box"
                android:tint="#A8B2D1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOWNLOADS"
                android:textSize="10sp"
                android:textColor="#8892B0"
                android:layout_marginTop="2dp"
                android:textAllCaps="true"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_news"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_info"
                android:tint="#A8B2D1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHAT'S NEW"
                android:textSize="10sp"
                android:textColor="#8892B0"
                android:layout_marginTop="2dp"
                android:textAllCaps="true"
                android:letterSpacing="0.06" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═════════════ PROGRESS BAR ═════════════ -->
    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:elevation="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@+id/glass_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
