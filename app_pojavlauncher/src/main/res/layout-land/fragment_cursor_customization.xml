<?xml version="1.0" encoding="utf-8"?>
<!-- CURSOR STUDIO — CS Premium redesign (landscape, two-pane). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cs_page_bg">

    <!-- ── Glass header ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/cursor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_glass_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/cursor_back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cs_ghost_button"
            android:contentDescription="@string/global_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#E4E4EA" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cursor_header_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.22"
                android:text="STUDIO"
                android:textColor="#8F86C9"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cursor Customization"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/cursor_studio_status"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_cs_chip_accent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="LIVE"
            android:textColor="#C9BFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Two-pane body ───────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar">

        <!-- LEFT: live preview stage -->
        <FrameLayout
            android:id="@+id/cursor_preview_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_cs_glass_card">

            <ImageView
                android:id="@+id/cursor_preview_image"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mouse_pointer" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cursor_pack_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Classic Arrow"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cursor_pack_creator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="by CS Studio"
                    android:textColor="#8B8FA3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/cursor_pack_category"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_cs_chip_accent"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="CLASSIC"
                    android:textColor="#C9BFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/cursor_preview_label"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="14dp"
                android:background="@drawable/bg_cs_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="CLASSIC"
                android:textColor="#E9E4FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cursor_preview_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="14dp"
                android:text="Scale: 100% | Opacity: 100%"
                android:textColor="#666B7E"
                android:textSize="10.5sp" />
        </FrameLayout>

        <!-- RIGHT: scrollable controls -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.18"
                    android:text="CURSOR PACKS"
                    android:textColor="#C9BFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/cursor_cat_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <GridLayout
                    android:id="@+id/cursor_pack_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.18"
                    android:text="QUICK STYLE"
                    android:textColor="#C9BFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/style_classic"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_cs_pack_card_selected">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mouse_pointer" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/style_gamepad"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_cs_pack_card">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_gamepad_pointer" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/style_custom"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_cs_pack_card">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_upload"
                            app:tint="#C9CBD6" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Tuning -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_cs_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:letterSpacing="0.18"
                        android:text="TUNING"
                        android:textColor="#C9BFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cursor Scale"
                            android:textColor="#D7D9E4"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/scale_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="#B8A9FF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_cursor_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:max="300"
                        android:progress="100"
                        android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                        android:thumb="@drawable/bg_settings_seekbar_thumb" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cursor Opacity"
                            android:textColor="#D7D9E4"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/opacity_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="#B8A9FF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_cursor_opacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                        android:thumb="@drawable/bg_settings_seekbar_thumb" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Preview Pulse Speed"
                            android:textColor="#D7D9E4"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/anim_speed_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50%"
                            android:textColor="#B8A9FF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_anim_speed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="50"
                        android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                        android:thumb="@drawable/bg_settings_seekbar_thumb" />
                </LinearLayout>

                <!-- Glow -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_cs_glass_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:letterSpacing="0.18"
                        android:text="GLOW EFFECTS"
                        android:textColor="#C9BFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Glow Intensity"
                            android:textColor="#D7D9E4"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/glow_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#B8A9FF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_glow_strength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="60"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                        android:thumb="@drawable/bg_settings_seekbar_thumb" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView android:id="@+id/color_green" style="@style/CsColorSwatch" android:backgroundTint="#A6FF3D" />
                        <ImageView android:id="@+id/color_cyan" style="@style/CsColorSwatch" android:backgroundTint="#C9CBD6" />
                        <ImageView android:id="@+id/color_purple" style="@style/CsColorSwatch" android:backgroundTint="#D500F9" />
                        <ImageView android:id="@+id/color_red" style="@style/CsColorSwatch" android:backgroundTint="#FF3D00" />
                        <ImageView android:id="@+id/color_yellow" style="@style/CsColorSwatch" android:backgroundTint="#FFEA00" />
                        <ImageView android:id="@+id/color_white" style="@style/CsColorSwatch" android:backgroundTint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Import zone -->
                <FrameLayout
                    android:id="@+id/upload_zone"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_cs_dashed_drop">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_upload"
                            app:tint="#B8A9FF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Tap to import a PNG cursor"
                            android:textColor="#B8A9FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_import_png"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="Import PNG"
                        android:textAllCaps="true"
                        android:textColor="#C9BFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_cs_ghost_button" />

                    <Button
                        android:id="@+id/btn_export_cursor"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="Export"
                        android:textAllCaps="true"
                        android:textColor="#C9BFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_cs_ghost_button" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="18dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_save_cursor"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="APPLY"
                        android:textAllCaps="true"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:background="@drawable/bg_cs_primary_button" />

                    <ImageButton
                        android:id="@+id/btn_favorite_cursor"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_cs_ghost_button"
                        android:contentDescription="Favorite"
                        android:padding="13dp"
                        android:src="@drawable/ic_heart_outline"
                        app:tint="#A8ACBF" />

                    <Button
                        android:id="@+id/btn_reset_cursor"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="RESET"
                        android:textAllCaps="true"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:background="@drawable/bg_cs_danger_button" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
