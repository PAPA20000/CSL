<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     CS LAUNCHER V3 — Premium Design System (Phase 2, brand-matched)
     Tokens are mapped 1:1 to the real launcher palette in colors.xml:
       • Base obsidian   → bg_primary      #0B0B0E
       • Surfaces        → bg_sidebar/card #121212 / #1C1C1C / #242424
       • Primary accent  → accent_primary  #E4E4EA (platinum, PLAY button)
       • Brand violet    → accent_purple   #9B59E8 (client-features glow)
       • Success         → installed_color #22C55E
       • Danger          → like_active     #FF4444
     ═══════════════════════════════════════════════════════════════════ -->
<resources>
    <!-- Base layers (exact brand values) -->
    <color name="cs_bg_base">#0B0B0E</color>
    <color name="cs_bg_surface">#121212</color>
    <color name="cs_bg_elevated">#1C1C1C</color>
    <color name="cs_bg_overlay">#242424</color>

    <!-- Glass -->
    <color name="cs_glass_fill">#0FFFFFFF</color>
    <color name="cs_glass_fill_strong">#17FFFFFF</color>
    <color name="cs_glass_stroke">#26FFFFFF</color>
    <color name="cs_glass_stroke_soft">#1AFFFFFF</color>

    <!-- Primary accent — platinum silver (the CS Launcher identity) -->
    <color name="cs_accent">#E4E4EA</color>
    <color name="cs_accent_deep">#C9CBD6</color>
    <color name="cs_accent_light">#F4F4F8</color>
    <color name="cs_accent_soft">#33E4E4EA</color>
    <color name="cs_accent_glow">#40E4E4EA</color>

    <!-- Brand violet — reserved for hero glow / client features -->
    <color name="cs_violet">#9B59E8</color>
    <color name="cs_violet_deep">#7B2FBE</color>
    <color name="cs_violet_soft">#339B59E8</color>

    <!-- Legacy alias kept so Phase-1 references stay valid -->
    <color name="cs_cyan">#9B59E8</color>

    <!-- Semantic -->
    <color name="cs_success">#22C55E</color>
    <color name="cs_success_soft">#2622C55E</color>
    <color name="cs_danger">#FF4444</color>
    <color name="cs_danger_deep">#D63A3A</color>
    <color name="cs_danger_soft">#26FF4444</color>
    <color name="cs_warning">#FFB020</color>
    <color name="cs_warning_soft">#26FFB020</color>

    <!-- Text (exact brand values) -->
    <color name="cs_text_primary">#FFFFFF</color>
    <color name="cs_text_secondary">#9CA3AF</color>
    <color name="cs_text_dim">#6B7280</color>
    <color name="cs_text_on_accent">#0D0D0D</color>
    <color name="cs_text_accent">#E4E4EA</color>
</resources>
