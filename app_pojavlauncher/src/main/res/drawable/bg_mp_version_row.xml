<?xml version="1.0" encoding="utf-8"?>
<!-- MP VERSION ROW — pressable list row with left accent line -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22E4E4EA">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient android:angle="0" android:startColor="#181A21" android:endColor="#101116" />
                    <stroke android:width="1dp" android:color="#22E4E4EA" />
                </shape>
            </item>
            <item android:width="3dp">
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="16dp" android:bottomLeftRadius="16dp" />
                    <gradient android:angle="90" android:startColor="#C9CBD6" android:endColor="#33C9CBD6" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
