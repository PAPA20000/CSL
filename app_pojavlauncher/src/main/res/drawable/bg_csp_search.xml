<?xml version="1.0" encoding="utf-8"?>
<!-- CSP SEARCH FIELD — deep inset with platinum focus ring -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1.5dp" android:color="#E4E4EA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0AFFFFFF" />
            <stroke android:width="1dp" android:color="#1AE4E4EA" />
        </shape>
    </item>
</selector>
