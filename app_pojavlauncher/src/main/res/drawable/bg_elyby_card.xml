<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft contact shadow -->
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#24000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- face -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#24222A"
                android:endColor="#18161C"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#33FF4081" />
        </shape>
    </item>
    <!-- top glass highlight -->
    <item
        android:bottom="3dp"
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#28FFFFFF" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
