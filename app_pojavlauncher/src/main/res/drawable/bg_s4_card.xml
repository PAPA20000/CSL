<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 Redesigned Glass/Violet Settings Category Card -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#38B39DDB">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="315" android:startColor="#1F1836" android:endColor="#130E22" />
            <stroke android:width="1.2dp" android:color="#44B39DDB" />
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="22.5dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
    <item android:top="1.5dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="#22B39DDB" android:centerColor="#08B39DDB" android:endColor="#00000000" />
        </shape>
    </item>
</ripple>
