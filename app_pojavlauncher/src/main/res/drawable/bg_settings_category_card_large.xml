<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#28C9CBD6">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#18233A"
                        android:centerColor="#132034"
                        android:endColor="#0C1728" />
                    <corners android:radius="22dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#66C9CBD6" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#10192B"
                        android:centerColor="#0D1626"
                        android:endColor="#09111D" />
                    <corners android:radius="22dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#1EFFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
