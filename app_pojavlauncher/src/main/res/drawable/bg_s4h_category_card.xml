<?xml version="1.0" encoding="utf-8"?>
<!-- Settings-HOME category card (hub grid):
     layered graphite depth + platinum rim + press ripple -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26E4E4EA">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#1E1F26"
                        android:centerColor="#17181E"
                        android:endColor="#121316" />
                    <corners android:radius="18dp" />
                    <stroke android:width="1dp" android:color="#2F2F38" />
                </shape>
            </item>
            <!-- soft top-light hairline -->
            <item android:top="0.8dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <corners android:radius="17dp" />
                    <stroke android:width="0.8dp" android:color="#16FFFFFF" />
                </shape>
            </item>
            <!-- faint violet corner aura (brand whisper, not a recolor) -->
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="315"
                        android:startColor="#149B59E8"
                        android:centerColor="#009B59E8"
                        android:endColor="#009B59E8" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
