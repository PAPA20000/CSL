<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 Professional Graphite Value Capsule -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26E4E4EA">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="#0E0F13" />
                    <stroke android:width="1dp" android:color="#2EE4E4EA" />
                </shape>
            </item>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <gradient android:angle="270" android:startColor="#10FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
