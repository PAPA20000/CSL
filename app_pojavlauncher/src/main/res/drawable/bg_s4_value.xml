<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 Redesigned Value Capsule — glowing violet pill for dropdowns & values -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#38B39DDB">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <solid android:color="#181326" />
                    <stroke android:width="1dp" android:color="#44B39DDB" />
                </shape>
            </item>
            <item android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="999dp" />
                    <gradient android:angle="270" android:startColor="#25B39DDB" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
