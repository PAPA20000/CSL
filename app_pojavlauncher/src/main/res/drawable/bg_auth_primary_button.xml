<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0C2A1C" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#7AA088" android:endColor="#6A8E79" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#18000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#9DC9AE" android:endColor="#88B095" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="#33FFFFFF" />
                </shape>
            </item>
            <item android:bottom="2dp" android:gravity="top" android:height="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#55FFFFFF" />
                    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
