<?xml version="1.0" encoding="utf-8"?>
<!-- Featured account option — slightly elevated stroke + brighter stack -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#26E4E4EA">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1C1C24"
                android:endColor="#141419" />
            <stroke
                android:width="1.2dp"
                android:color="#3A3A46" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
