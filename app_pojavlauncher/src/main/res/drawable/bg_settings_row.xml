<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#24C9CBD6">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#17243A"
                        android:centerColor="#132137"
                        android:endColor="#0D1829" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#66C9CBD6" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#121D30"
                        android:centerColor="#0F1929"
                        android:endColor="#0A1322" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#1EFFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
