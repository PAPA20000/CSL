<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 Redesigned Settings Row Background -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#38B39DDB">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#2A2040"
                        android:centerColor="#201830"
                        android:endColor="#181324" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#7E57C2" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#1E192D"
                        android:centerColor="#161222"
                        android:endColor="#100D1A" />
                    <corners android:radius="18dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#26B39DDB" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
