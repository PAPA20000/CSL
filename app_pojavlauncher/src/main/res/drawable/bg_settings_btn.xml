<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 Professional Graphite Settings Action Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#383C4A" />
            <stroke android:width="1dp" android:color="#77E4E4EA" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#282B36" />
            <stroke android:width="1dp" android:color="#33E4E4EA" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
