<?xml version="1.0" encoding="utf-8"?>
<!-- Search capsule: pill field with focus hairline -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A21" />
            <stroke android:width="1.2dp" android:color="#4A4A55" />
            <corners android:radius="22dp" />
            <padding android:left="12dp" android:right="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#17171D" />
            <stroke android:width="1dp" android:color="#2A2A32" />
            <corners android:radius="22dp" />
            <padding android:left="12dp" android:right="10dp" />
        </shape>
    </item>
</selector>
