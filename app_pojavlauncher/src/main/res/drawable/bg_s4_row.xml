<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 True Neutral Dark Grey Setting Row -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22FFFFFF">
    <item android:id="@android:id/background">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <solid android:color="#141414" />
                </shape>
            </item>
            <item android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient android:angle="315" android:startColor="#222222" android:endColor="#181818" />
                    <stroke android:width="1dp" android:color="#3A3A3A" />
                </shape>
            </item>
            <item android:top="1.5dp" android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="20.5dp" />
                    <gradient android:angle="270" android:startColor="#18FFFFFF" android:centerColor="#05FFFFFF" android:endColor="#00000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
