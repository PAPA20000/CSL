<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 Redesigned Settings Row — Minecraftia Glass & Violet styling -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#38B39DDB">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#0D0A14" />
        </shape>
    </item>
    <item android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="315" android:startColor="#1B162B" android:endColor="#120E1E" />
            <stroke android:width="1dp" android:color="#33B39DDB" />
        </shape>
    </item>
    <item android:top="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20.5dp" />
            <gradient android:angle="270" android:startColor="#22B39DDB" android:centerColor="#08B39DDB" android:endColor="#00000000" />
        </shape>
    </item>
</ripple>
