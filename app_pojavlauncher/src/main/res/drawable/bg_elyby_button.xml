<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4A1528" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#E91E63"
                        android:endColor="#C2185B"
                        android:type="linear" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#3A3036" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#33000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#FF5A9A"
                        android:endColor="#FF4081"
                        android:type="linear" />
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#44FFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:gravity="top"
                android:height="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#55FFFFFF" />
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
