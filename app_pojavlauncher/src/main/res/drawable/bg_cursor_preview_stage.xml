<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B121E" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#33C9CBD6" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#141E32"
                android:centerColor="#0C1524"
                android:endColor="#101A2C"
                android:type="linear" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
