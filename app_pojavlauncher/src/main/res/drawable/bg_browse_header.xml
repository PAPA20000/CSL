<?xml version="1.0" encoding="utf-8"?>
<!-- Browse header: flat dark bar with faint bottom hairline -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111116" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#24242C" />
        </shape>
    </item>
</layer-list>
