<?xml version="1.0" encoding="utf-8"?>
<!-- PRIMARY BUTTON (SAVE/APPLY) — bright violet gradient, white bold text,
     built-in ripple. Meets WCAG contrast (white on #5A3EE8+). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item android:id="@android:id/background">
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#2A2A38" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#6A4DF0"
                        android:endColor="#8E3FF2" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#7C5CFF"
                        android:endColor="#A349FF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
