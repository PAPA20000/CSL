<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 Redesigned Glass/Violet Settings Preference Card -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#38B39DDB">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#241B3B" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#9575CD" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="315"
                        android:startColor="#1A162B"
                        android:endColor="#13101E" />
                    <stroke
                        android:width="1dp"
                        android:color="#33B39DDB" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
