<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 Professional Graphite/Dark-Grey Preference Card -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22E4E4EA">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <solid android:color="#1B1E28" />
                    <stroke
                        android:width="1dp"
                        android:color="#40E4E4EA" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="315"
                        android:startColor="#1C1F27"
                        android:endColor="#111216" />
                    <stroke
                        android:width="1dp"
                        android:color="#22E4E4EA" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
