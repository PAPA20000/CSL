<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     BROWSE MOD CARD (ground-up redo)
     Icon tile + source badge • title + downloads chip • author •
     description • white GET button + like heart
═════════════════════════════════════════════════════════════════ -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:background="@drawable/bg_browse_mod_card"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="11dp">

        <!-- Icon tile with overlapping source badge -->
        <FrameLayout
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_browse_icon_frame"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/mod_thumbnail_imageview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@mipmap/ic_launcher_foreground" />
            </FrameLayout>

            <ImageView
                android:id="@+id/mod_source_imageview"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle"
                android:padding="2dp"
                android:elevation="2dp"
                tools:src="@drawable/ic_modrinth" />
        </FrameLayout>

        <!-- Text column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="13dp">

            <!-- Title row: title + downloads chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/mod_title_textview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F0F0F3"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Fabric API" />

                <TextView
                    android:id="@+id/mod_downloads_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_browse_dl_chip"
                    android:gravity="center_vertical"
                    android:drawablePadding="4dp"
                    android:maxLines="1"
                    android:textColor="#DADDE5"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_download_trend"
                    app:drawableTint="#9C9CA8"
                    tools:text="179M"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/mod_info_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#D8C79A"
                android:textSize="11sp"
                tools:text="by modmuss50" />

            <TextView
                android:id="@+id/mod_body_textview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="#9C9CA8"
                android:textSize="12sp"
                tools:text="Lightweight and modular API providing common hooks and intercompatibility measures for Fabric mods." />
        </LinearLayout>

        <!-- Actions: GET + like -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="10dp">

            <ImageButton
                android:id="@+id/btn_install"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_browse_get_button"
                android:contentDescription="@string/browse_install_cd"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_download_trend"
                android:tint="#0E0E11" />

            <ImageButton
                android:id="@+id/btn_like"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="7dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browse_like_cd"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_heart_outline" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
