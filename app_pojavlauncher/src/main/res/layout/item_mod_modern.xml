<?xml version="1.0" encoding="utf-8"?>
<!-- ✦ Premium immersive mod card — Grid style matching Home Profile Cards -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mod_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_premium_card_gradient"
    android:clickable="true"
    android:focusable="true"
    android:clipChildren="true">

    <!-- Gallery Background Slideshow Layer -->
    <ImageView
        android:id="@+id/mod_background_image_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0" />

    <ImageView
        android:id="@+id/mod_background_image_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0" />

    <!-- Gradient Scrim for readability — Improved for vibrant images -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_mod_card_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Identity row: Icon + Title stack -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- Icon with luminous ring -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">
                
                <ImageView
                    android:id="@+id/mod_thumbnail_imageview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:background="@drawable/bg_profile_icon_rounded"
                    android:scaleType="fitCenter"
                    tools:src="@mipmap/ic_launcher_foreground" />

                <ImageView
                    android:id="@+id/mod_source_imageview"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circle"
                    android:padding="2dp"
                    android:elevation="2dp"
                    tools:src="@drawable/ic_modrinth" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/mod_title_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F2F2F5"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Fabric API" />

                <TextView
                    android:id="@+id/mod_info_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D8C79A"
                    android:textSize="10sp"
                    android:layout_marginTop="1dp"
                    tools:text="by modmuss50" />
                
                <TextView
                    android:id="@+id/mod_downloads_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#9C9CA8"
                    android:textSize="9.5sp"
                    android:fontFamily="sans-serif-medium"
                    app:drawableStartCompat="@drawable/ic_download_trend"
                    app:drawableTint="#7C7C88"
                    android:drawablePadding="3dp"
                    tools:text="179M" />

            </LinearLayout>
        </LinearLayout>

        <!-- Description (Truncated) -->
        <TextView
            android:id="@+id/mod_body_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#A8B2D1"
            android:textSize="11.5sp"
            android:lineSpacingExtra="1dp"
            tools:text="Lightweight and modular API providing common hooks and intercompatibility measures for Fabric mods." />

        <!-- Bottom Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <ImageButton
                android:id="@+id/btn_like"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_heart_outline" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_install"
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_play_button_green"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_download_trend"
                android:tint="#0E0E11" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
