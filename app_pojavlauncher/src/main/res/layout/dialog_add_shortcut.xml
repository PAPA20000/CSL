<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- ── Header ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/shortcut_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back_white"
                android:contentDescription="@string/global_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcut_add_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text" />

                <TextView
                    android:id="@+id/shortcut_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/shortcut_add_subtitle"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/secondary_text" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/shortcut_manage"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_shortcut_manage"
                android:tint="@color/premium_cyan"
                android:contentDescription="@string/shortcut_manage_title" />
        </LinearLayout>

        <!-- ── Unsupported launcher warning ───────────────────────── -->
        <TextView
            android:id="@+id/shortcut_unsupported_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/bg_shortcut_warning"
            android:text="@string/shortcut_pin_unsupported"
            android:textColor="#D8C79A"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ── Live preview ───────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:background="@drawable/bg_glass_card_premium"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Mock home screen tile -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/shortcut_icon_preview"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/shortcut_icon_label" />

                <TextView
                    android:id="@+id/shortcut_label_preview"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textColor="@color/primary_text" />
            </LinearLayout>

            <TextView
                android:id="@+id/shortcut_preview_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="@string/shortcut_preview_hint"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/secondary_text" />
        </LinearLayout>

        <!-- ── Action picker ──────────────────────────────────────── -->
        <TextView
            style="@style/ShortcutSectionHeader"
            android:text="@string/shortcut_action_label" />

        <TextView
            style="@style/ShortcutSectionCaption"
            android:text="@string/shortcut_action_caption" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shortcut_action_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />

        <!-- ── Name ───────────────────────────────────────────────── -->
        <TextView
            style="@style/ShortcutSectionHeader"
            android:text="@string/shortcut_name_label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/shortcut_name_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:counterEnabled="true"
            app:counterMaxLength="25"
            android:hint="@string/shortcut_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/shortcut_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Icon source ────────────────────────────────────────── -->
        <TextView
            style="@style/ShortcutSectionHeader"
            android:text="@string/shortcut_icon_choose" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_icon_profile"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="11sp"
                android:text="@string/shortcut_icon_profile" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_icon_skin_head"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="11sp"
                android:text="@string/shortcut_icon_skin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_icon_loader"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="11sp"
                android:text="@string/shortcut_icon_loader" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_icon_custom"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textSize="11sp"
                android:text="@string/shortcut_icon_custom" />
        </LinearLayout>

        <!-- ── Icon shape ─────────────────────────────────────────── -->
        <TextView
            style="@style/ShortcutSectionHeader"
            android:text="@string/shortcut_shape_label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/shortcut_shape_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shape_squircle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:text="@string/shortcut_shape_squircle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shape_circle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:text="@string/shortcut_shape_circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shape_rounded"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:text="@string/shortcut_shape_rounded" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shape_square"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11sp"
                android:text="@string/shortcut_shape_square" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ── Options ────────────────────────────────────────────── -->
        <TextView
            style="@style/ShortcutSectionHeader"
            android:text="@string/shortcut_options_label" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/shortcut_switch_adaptive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"
            android:textSize="13sp"
            android:textColor="@color/primary_text"
            android:text="@string/shortcut_option_adaptive" />

        <TextView
            style="@style/ShortcutSectionCaption"
            android:text="@string/shortcut_option_adaptive_desc" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/shortcut_switch_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:textSize="13sp"
            android:textColor="@color/primary_text"
            android:text="@string/shortcut_option_badge" />

        <TextView
            style="@style/ShortcutSectionCaption"
            android:text="@string/shortcut_option_badge_desc" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/shortcut_switch_dynamic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:textSize="13sp"
            android:textColor="@color/primary_text"
            android:text="@string/shortcut_option_dynamic" />

        <TextView
            style="@style/ShortcutSectionCaption"
            android:text="@string/shortcut_option_dynamic_desc" />

        <!-- ── Create ─────────────────────────────────────────────── -->
        <Button
            android:id="@+id/btn_create_shortcut"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:text="@string/shortcut_create_btn"
            android:textSize="15sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
