<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     In-game menu tile (Phase 5, Req-4). Used by the stock ArrayAdapter
     3-arg constructor — the ROOT MUST BE A TextView (framework contract),
     id MUST be @android:id/text1.
══════════════════════════════════════════════════════════════════ -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_ingame_menu_ripple"
    android:drawableStart="@drawable/ic_ingame_spine"
    android:drawableEnd="@drawable/ic_chevron_right"
    android:drawablePadding="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:textColor="#ECECF2"
    android:textSize="13sp"
    android:fontFamily="sans-serif-medium"
    android:letterSpacing="0.01"
    android:ellipsize="end"
    android:maxLines="1" />
