<?xml version="1.0" encoding="utf-8"?>
<!-- One live install row inside the runtime setup deck. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/install_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_runtime_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_deck_icon_tile">

        <TextView
            android:id="@+id/install_major_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-light"
            android:textColor="#F2F2F5"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="17" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/install_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F0F0F3"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Java 17" />

            <TextView
                android:id="@+id/install_state_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_runtime_chip_neutral"
                android:textColor="#9C9CA8"
                android:textSize="8.5sp"
                android:textStyle="bold"
                tools:text="QUEUED" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/install_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_install_progress_track" />

        <TextView
            android:id="@+id/install_stats_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#7C7C88"
            android:textSize="10.5sp"
            tools:text="12.4 / 55 MB  •  4.2 MB/s  •  ~10s" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="10dp">

        <ImageView
            android:id="@+id/install_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_check_circle"
            android:padding="5dp"
            android:src="@drawable/ic_check_small"
            android:visibility="gone"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/install_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#D8C79A"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

</LinearLayout>
