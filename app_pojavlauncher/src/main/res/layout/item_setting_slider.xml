<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_settings_row"
    android:minHeight="78dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_settings_icon_well">

            <ImageView
                android:id="@+id/setting_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_setting_ram"
                app:tint="#00E5FF" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/setting_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F4F8FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setting_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#8FA3BC"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/setting_value_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_value_chip"
            android:gravity="center"
            android:minWidth="58dp"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="#7AFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/setting_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:progressDrawable="@drawable/bg_settings_seekbar_progress"
        android:splitTrack="false"
        android:thumb="@drawable/bg_settings_seekbar_thumb"
        android:thumbOffset="0dp" />

</LinearLayout>
