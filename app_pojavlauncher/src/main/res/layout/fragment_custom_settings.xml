<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     LAUNCHER SETTINGS — V4 (Phase 4 redesign)
     Complete visual rebuild: floating glass header capsule, hero glow,
     pill search, new category rail, obsidian cards with hairline
     highlights and a floating save capsule.
     ALL view IDs preserved from Phase 2/3 — zero Java breakage.
     ═══════════════════════════════════════════════════════════════════ -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cs_page_bg">

    <!-- Hero glow behind the header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/bg_setting_hero"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ── Floating glass header capsule ── -->
    <LinearLayout
        android:id="@+id/settings_header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_setting_header_v4"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:id="@+id/settings_back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_setting_iconwell_v4"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#E4E4EA" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_setting_iconwell_v4">

                <ImageView
                    android:id="@+id/settings_header_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_menu_settings"
                    app:tint="#E4E4EA" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cs_settings_title"
                    android:letterSpacing="0.02"
                    android:textColor="#FFFFFF"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#6B7280"
                    android:textSize="10.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_csp_value"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:textColor="#FFC97A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Search — pill field -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_setting_search_v4"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_cs_search"
                app:tint="#6B7280" />

            <EditText
                android:id="@+id/settings_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="@string/cs_settings_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Category pill rail -->
        <HorizontalScrollView
            android:id="@+id/settings_category_rail_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/settings_category_rail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Settings list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/settings_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="116dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settings_header_bar" />

    <!-- ── Floating "Unsaved changes" capsule ── -->
    <LinearLayout
        android:id="@+id/unsaved_changes_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:cardBackgroundColor="#FA121418"
            app:cardCornerRadius="30dp"
            app:cardElevation="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <TextView
                    android:id="@+id/save_status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/cs_settings_unsaved"
                    android:textColor="#FFC97A"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_save_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="96dp"
                    android:background="@drawable/bg_setting_rail_active"
                    android:text="@string/cs_settings_save"
                    android:textColor="#0D0D0D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
