<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:orientation="vertical">

        <!-- ── Profile Icon ── -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_profile_icon_glow">

            <ImageView
                android:id="@+id/wizard_profile_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:src="@drawable/bg_hero_minecraft" />

            <ImageView
                android:id="@+id/wizard_profile_icon_edit"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_edit_profile"
                android:background="@drawable/background_icon_edit_new"
                android:padding="3dp"
                android:elevation="4dp" />
        </FrameLayout>

        <!-- ── Profile Name ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROFILE NAME"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/wizard_profile_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/background_line_new"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:hint="Enter profile name"
            android:inputType="textPersonName"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="20dp" />

        <!-- ── RAM Allocation ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RAM ALLOCATION"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/background_line_new"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/wizard_ram_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2048 MB"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/wizard_ram_decrease"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_remove"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Decrease RAM" />

            <ImageButton
                android:id="@+id/wizard_ram_increase"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_add"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_marginStart="8dp"
                android:contentDescription="Increase RAM" />
        </LinearLayout>

        <!-- ── Game Directory ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME DIRECTORY"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/background_line_new"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/wizard_game_dir"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="custom_instances/ProfileName"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:ellipsize="middle"
                android:singleLine="true" />

            <Button
                android:id="@+id/wizard_game_dir_browse"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Browse"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:background="@drawable/bg_chip_dark"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- ── Java Runtime ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JAVA RUNTIME"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/wizard_java_runtime"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/background_line_new"
            android:layout_marginBottom="20dp" />

        <!-- ── Renderer ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RENDERER"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/wizard_renderer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/background_line_new"
            android:layout_marginBottom="20dp" />


        <!-- ── Browse Resources (Optional) ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESOURCES (OPTIONAL)"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/wizard_browse_resources"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Browse &amp; Install Resources"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_glass_card_premium"
            android:layout_marginBottom="20dp" />

        <!-- ── JVM Arguments ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JVM ARGUMENTS (OPTIONAL)"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/wizard_jvm_args"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/background_line_new"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:hint="-Xmx2048M -Dsun.java2d.opengl=true"
            android:inputType="textMultiLine"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</com.kdt.DefocusableScrollView>
