<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="16dp">

    <!-- Loader badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_card_premium"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loader: "
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wizard_selected_loader_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fabric"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/wizard_version_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/wizard_version_loading_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Fetching versions…"
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <!-- Filter chips -->
    <LinearLayout
        android:id="@+id/wizard_version_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/wizard_filter_release"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Release"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_dark"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/wizard_filter_snapshot"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Snapshot"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:background="@drawable/bg_chip_dark"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Version list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wizard_version_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Selected version display -->
    <LinearLayout
        android:id="@+id/wizard_version_selected_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_card_premium"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected: "
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wizard_version_selected_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00FF41"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
