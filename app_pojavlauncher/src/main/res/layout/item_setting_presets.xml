<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     PERFORMANCE — one-tap device presets (user req).
     LOW-END / HIGH-END cards apply a curated bundle of REAL prefs
     (RAM allocation, resolution scale, vsync, zink vsync, sustained mode).
     Controller-page master recipe: graphite gradient, 20dp, hairline stroke.
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_s4h_category_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_s4h_icon_tile">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings_performance"
                app:tint="#EDEDF2" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Performance Presets"
                android:textColor="#F3F3F7"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="One tap tunes RAM, resolution, vsync and sustained mode for your device class"
                android:textColor="#9A9AA6"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/preset_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_s4h_badge_chip"
            android:letterSpacing="0.1"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp"
            android:textColor="#E4E4EA"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Preset cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- LOW-END -->
        <LinearLayout
            android:id="@+id/preset_low_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_s4_value"
            android:orientation="vertical"
            android:padding="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="LOW-END MOBILE"
                android:textColor="#C9CBD6"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/preset_low_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingMultiplier="1.25"
                android:text="1280 MB RAM\n70% resolution\nVSync off (both)\nSustained mode off"
                android:textColor="#8E8E9A"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/preset_low_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_cs_tab_pill_idle"
                android:letterSpacing="0.1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="7dp"
                android:text="APPLY"
                android:textColor="#E4E4EA"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- HIGH-END -->
        <LinearLayout
            android:id="@+id/preset_high_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_s4_value"
            android:orientation="vertical"
            android:padding="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="HIGH-END MOBILE"
                android:textColor="#F0F0F3"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/preset_high_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingMultiplier="1.25"
                android:text="— MB RAM\n100% resolution\nVSync off (both)\nSustained mode ON"
                android:textColor="#9C9CA8"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/preset_high_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_cs_tab_pill_active"
                android:letterSpacing="0.1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="7dp"
                android:text="APPLY"
                android:textColor="#151518"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Applies instantly and refreshes live values. Fine-tune individual options afterwards in their own sections."
        android:textColor="#6E7078"
        android:textSize="8.5sp" />

</LinearLayout>
