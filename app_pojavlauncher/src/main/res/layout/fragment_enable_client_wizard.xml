<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_cosmic_gradient">

    <!-- ══ Glass Header ══ -->
    <LinearLayout
        android:id="@+id/wizard_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_glass_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/wizard_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_browse_filter_btn"
            android:contentDescription="@string/global_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#E4E4EA" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="14dp"
            android:contentDescription="CS Launcher"
            android:src="@drawable/ic_cs_logo_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CS LAUNCHER V3"
                android:textColor="#7C7C88"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/wizard_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable CS Client"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Step indicator chips -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step_chip_1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="1"
                android:textColor="#0E0E11"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/step_chip_2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="2"
                android:textColor="#0E0E11"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/step_chip_3"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_pill"
                android:gravity="center"
                android:text="3"
                android:textColor="#0E0E11"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ STEP 1 — Pick Minecraft version ══ -->
    <LinearLayout
        android:id="@+id/step_1_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wizard_header">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Choose a Minecraft version"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Fabric supported versions · 1.21 → 1.26.2"
            android:textColor="#9C9CA8"
            android:textSize="12.5sp" />

        <ProgressBar
            android:id="@+id/wizard_versions_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/premium_cyan" />

        <TextView
            android:id="@+id/wizard_versions_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Could not load versions. Check your connection."
            android:textColor="#E5A0A6"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wizard_version_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- ══ STEP 2 — Summary ══ -->
    <LinearLayout
        android:id="@+id/step_2_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wizard_header">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Everything will be installed automatically"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/summary_mc_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Minecraft 1.21.1"
            android:textColor="@color/premium_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_glass_card_premium"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHAT'S INCLUDED"
                android:textColor="#7C7C88"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <include
                android:id="@+id/row_fabric_loader"
                layout="@layout/item_client_component_row" />

            <include
                android:id="@+id/row_fabric_api"
                layout="@layout/item_client_component_row" />

            <include
                android:id="@+id/row_cs_client"
                layout="@layout/item_client_component_row" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="A new profile “CS CLIENT V1” will be created, pre-configured with CS CLIENT, Fabric Loader and Fabric API — ready to launch instantly."
            android:textColor="#9C9CA8"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/wizard_enable_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_play_button_green"
            android:text="ENABLE CS CLIENT"
            android:textColor="#0E0E11"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ══ STEP 3 — Installing ══ -->
    <LinearLayout
        android:id="@+id/step_3_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="36dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wizard_header">

        <ImageView
            android:id="@+id/wizard_install_logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="CS Launcher"
            android:src="@drawable/ic_cs_logo_placeholder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Installing CS CLIENT"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wizard_install_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Preparing installation..."
            android:textColor="#9C9CA8"
            android:textSize="12.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_glass_bar">

            <ProgressBar
                android:id="@+id/wizard_install_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_premium" />
        </FrameLayout>

        <TextView
            android:id="@+id/wizard_progress_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:text="0%"
            android:textColor="#E4E4EA"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
