<?xml version="1.0" encoding="utf-8"?>
<!-- Cursor Engine — single cursor-state row inside Cursor Studio -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_cs_ghost_button"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="11dp">

    <View
        android:id="@+id/state_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/state_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#E4E4EA"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/state_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_cs_chip"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="@string/cse_badge_system"
        android:textColor="#B9BBC4"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&#8250;"
        android:textColor="#9CA3AF"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
