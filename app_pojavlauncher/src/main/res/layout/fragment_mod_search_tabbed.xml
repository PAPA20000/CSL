<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_studio_page"
    android:orientation="vertical">

    <!-- ── HEADER ── -->
    <LinearLayout
        android:id="@+id/mod_store_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#141414"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/mod_store_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white"
            android:contentDescription="@string/global_back"
            android:tint="#39FF14" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mod_store_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse Resources"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mods • Resource Packs • Shaders"
                android:textColor="#39FF14"
                android:textSize="11sp"
                android:alpha="0.85"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <!-- Compact premium search pill in the corner -->
        <FrameLayout
            android:id="@+id/search_pill"
            android:layout_width="150dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_search_pill">

            <EditText
                android:id="@+id/search_mod_edittext"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search..."
                android:textColorHint="#5E7A66"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingStart="34dp"
                android:paddingEnd="10dp"
                android:gravity="center_vertical"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="11dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/ic_search"
                android:tint="#39FF14" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/search_mod_filter"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_browse_button"
            android:padding="8dp"
            android:src="@drawable/ic_filter"
            android:tint="#39FF14" />

    </LinearLayout>

    <!-- ── TAB BAR ── -->
    <HorizontalScrollView
        android:id="@+id/tab_scroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:background="#0D0D0D">

        <LinearLayout
            android:id="@+id/tab_bar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />

    </HorizontalScrollView>

    <!-- ── TAB INDICATOR ── -->
    <View
        android:id="@+id/tab_indicator"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#39FF14" />

    <!-- ── VIEWPAGER ── -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/download_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
