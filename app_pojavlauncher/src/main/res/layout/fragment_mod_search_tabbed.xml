<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     BROWSE RESOURCES (ground-up redo — Req: download resources UI)
     Header bar • full-width search capsule • segmented tab track
═════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_browse_page"
    android:orientation="vertical">

    <!-- ── Header: back • title • filter ─────────────────────────── -->
    <LinearLayout
        android:id="@+id/mod_store_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_browse_header"
        android:orientation="vertical"
        android:elevation="6dp"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/mod_store_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_browse_filter_btn"
                android:contentDescription="@string/global_back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back_white"
                android:tint="#E4E4EA" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/browse_eyebrow"
                    android:textColor="#7C7C88"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mod_store_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browse_title"
                    android:textColor="#F0F0F3"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageButton
                    android:id="@+id/search_mod_filter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_browse_filter_btn"
                    android:contentDescription="@string/browse_filter_cd"
                    android:padding="10dp"
                    android:src="@drawable/ic_filter"
                    android:tint="#E4E4EA" />

                <View
                    android:id="@+id/search_mod_filter_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_browse_filter_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- ── Full-width search capsule ─────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_browse_search_capsule"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_search"
                android:tint="#7C7C88" />

            <EditText
                android:id="@+id/search_mod_edittext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/browse_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#F0F0F3"
                android:textColorHint="#7C7C88"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── Segmented tab track ────────────────────────────────── -->
        <HorizontalScrollView
            android:id="@+id/tab_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tab_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_browse_tabs_track"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </LinearLayout>

    <View
        android:id="@+id/tab_indicator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- ── Result list region ─────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/download_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</LinearLayout>
