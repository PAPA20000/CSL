<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_cursor_studio_page">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/cursor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cursor_header"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/cursor_back_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_cursor_back_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_back"
                app:tint="#00E5FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.04"
                android:text="BACK"
                android:textColor="#E8F7FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="CURSOR STUDIO"
                android:textAllCaps="true"
                android:textColor="#66D9FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Cursor Customization"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_cursor_chip"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="LIVE"
            android:textColor="#00E5FF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/cursor_header_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_cursor_divider"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_header_line">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="16dp"
            android:paddingEnd="14dp">

            <!-- Live Preview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="LIVE PREVIEW"
                android:textColor="#66D9FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cursor_preview_container"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_cursor_preview_stage"
                android:elevation="4dp">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_cursor_preview_frame"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/cursor_preview_image"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:contentDescription="Current cursor preview"
                        android:padding="6dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_mouse_pointer" />
                </FrameLayout>

                <TextView
                    android:id="@+id/cursor_preview_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_cursor_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="DEFAULT"
                    android:textColor="#7AFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/cursor_preview_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="14dp"
                    android:text="Scale: 100% | Opacity: 100%"
                    android:textColor="#8FA3BC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Style -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="CURSOR STYLE"
                android:textColor="#66D9FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:id="@+id/style_classic"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cursor_style_card_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_settings_icon_well"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mouse_pointer" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Classic"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/style_gamepad"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cursor_style_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_settings_icon_well"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_gamepad_pointer" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gamepad"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/style_custom"
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cursor_style_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_settings_icon_well"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_upload"
                            app:tint="#00E5FF" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Custom"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Size -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="SIZE"
                android:textColor="#66D9FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_cursor_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.04"
                        android:text="CURSOR SCALE"
                        android:textColor="#F4F8FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/scale_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_value_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="100%"
                        android:textColor="#7AFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_cursor_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:max="300"
                    android:maxHeight="6dp"
                    android:minHeight="6dp"
                    android:progress="100"
                    android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_settings_seekbar_thumb"
                    android:thumbOffset="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Cursor hotspot is now auto-managed for a cleaner setup."
                    android:textColor="#8FA3BC"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Glow & Color -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="GLOW &amp; COLOR"
                android:textColor="#66D9FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_cursor_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.04"
                        android:text="GLOW INTENSITY"
                        android:textColor="#F4F8FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/glow_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_value_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="0%"
                        android:textColor="#7AFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_glow_strength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:max="60"
                    android:maxHeight="6dp"
                    android:minHeight="6dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_settings_seekbar_thumb"
                    android:thumbOffset="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.04"
                        android:text="CURSOR OPACITY"
                        android:textColor="#F4F8FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/opacity_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_value_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="100%"
                        android:textColor="#7AFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_cursor_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:max="100"
                    android:maxHeight="6dp"
                    android:minHeight="6dp"
                    android:progress="100"
                    android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_settings_seekbar_thumb"
                    android:thumbOffset="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.08"
                    android:text="GLOW COLOR PRESETS"
                    android:textColor="#8FA3BC"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:id="@+id/color_green"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_cursor_color_ring"
                            android:backgroundTint="#A6FF3D"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="2dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#000000" />

                        <ImageView
                            android:id="@+id/color_cyan"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_cursor_color_ring"
                            android:backgroundTint="#00E5FF"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp" />

                        <ImageView
                            android:id="@+id/color_purple"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_cursor_color_ring"
                            android:backgroundTint="#D500F9"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp" />

                        <ImageView
                            android:id="@+id/color_red"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_cursor_color_ring"
                            android:backgroundTint="#FF3D00"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp" />

                        <ImageView
                            android:id="@+id/color_yellow"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_cursor_color_ring"
                            android:backgroundTint="#FFEA00"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp" />

                        <ImageView
                            android:id="@+id/color_white"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_cursor_color_ring"
                            android:backgroundTint="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Import / Export -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.12"
                android:text="IMPORT &amp; EXPORT"
                android:textColor="#66D9FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_cursor_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/upload_zone"
                    android:layout_width="match_parent"
                    android:layout_height="108dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_cursor_upload_zone"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_upload"
                        app:tint="#00E5FF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to add cursor image"
                        android:textColor="#C9D7EA"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="PNG · WEBP · JPG supported"
                        android:textColor="#8FA3BC"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.kdt.mcgui.MineButton
                        android:id="@+id/btn_import_png"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cursor_btn_primary"
                        android:stateListAnimator="@null"
                        android:text="IMPORT FILE"
                        android:textColor="#061018"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.kdt.mcgui.MineButton
                        android:id="@+id/btn_export_cursor"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cursor_btn_secondary"
                        android:stateListAnimator="@null"
                        android:text="EXPORT FILE"
                        android:textColor="#7AFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Actions -->
            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_save_cursor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_cursor_btn_primary"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"
                android:text="SAVE CHANGES"
                android:textColor="#061018"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.kdt.mcgui.MineButton
                android:id="@+id/btn_reset_cursor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_cursor_btn_danger"
                android:letterSpacing="0.06"
                android:stateListAnimator="@null"
                android:text="RESET TO DEFAULT"
                android:textColor="#FFCDD2"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
