<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     CURSOR STUDIO — CS Premium redesign (portrait)
     Contains every ID referenced by CursorCustomizationFragment.
     ═══════════════════════════════════════════════════════════════════ -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cs_page_bg">

    <!-- ── Glass header ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/cursor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@drawable/bg_glass_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/cursor_back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cs_ghost_button"
            android:contentDescription="@string/global_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#E4E4EA" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.22"
                android:text="STUDIO"
                android:textColor="#9CA3AF"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cursor Customization"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_cs_chip_accent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="LIVE"
            android:textColor="#E4E4EA"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ══ LIVE PREVIEW STAGE ══ -->
            <FrameLayout
                android:id="@+id/cursor_preview_container"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="@drawable/bg_cs_glass_card">

                <ImageView
                    android:id="@+id/cursor_preview_image"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mouse_pointer" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cursor_pack_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Classic Arrow"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cursor_pack_creator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="by CS Studio"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/cursor_pack_category"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_cs_chip_accent"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="CLASSIC"
                        android:textColor="#E4E4EA"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/cursor_preview_label"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_cs_chip"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="CLASSIC"
                    android:textColor="#E4E4EA"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cursor_preview_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="14dp"
                    android:text="Scale: 100% | Opacity: 100%"
                    android:textColor="#6B7280"
                    android:textSize="10.5sp" />
            </FrameLayout>

            <!-- ══ PACK BROWSER ══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.18"
                android:text="CURSOR PACKS"
                android:textColor="#E4E4EA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/cursor_cat_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <GridLayout
                android:id="@+id/cursor_pack_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3" />

            <!-- ══ QUICK STYLE (legacy trio, kept functional) ══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.18"
                android:text="QUICK STYLE"
                android:textColor="#E4E4EA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/style_classic"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_cs_pack_card_selected">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mouse_pointer" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/style_gamepad"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:background="@drawable/bg_cs_pack_card">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_gamepad_pointer" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/style_custom"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_cs_pack_card">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_upload"
                        app:tint="#C9CBD6" />
                </FrameLayout>
            </LinearLayout>

            <!-- ══ TUNING PANEL ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_cs_glass_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:letterSpacing="0.18"
                    android:text="TUNING"
                    android:textColor="#E4E4EA"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Scale -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cursor Scale"
                        android:textColor="#D7D9E4"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/scale_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#C9CBD6"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_cursor_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:max="300"
                    android:progress="100"
                    android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                    android:thumb="@drawable/bg_settings_seekbar_thumb" />

                <!-- Opacity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cursor Opacity"
                        android:textColor="#D7D9E4"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/opacity_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#C9CBD6"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_cursor_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:max="100"
                    android:progress="100"
                    android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                    android:thumb="@drawable/bg_settings_seekbar_thumb" />

                <!-- Animation speed (live preview pulse) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Preview Pulse Speed"
                        android:textColor="#D7D9E4"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/anim_speed_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50%"
                        android:textColor="#C9CBD6"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_anim_speed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                    android:thumb="@drawable/bg_settings_seekbar_thumb" />
            </LinearLayout>

            <!-- ══ GLOW PANEL ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cs_glass_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:letterSpacing="0.18"
                    android:text="GLOW EFFECTS"
                    android:textColor="#E4E4EA"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Glow Intensity"
                        android:textColor="#D7D9E4"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/glow_value_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#C9CBD6"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_glow_strength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="60"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_settings_seekbar_progress"
                    android:thumb="@drawable/bg_settings_seekbar_thumb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView android:id="@+id/color_green" style="@style/CsColorSwatch" android:backgroundTint="#A6FF3D" />
                    <ImageView android:id="@+id/color_cyan" style="@style/CsColorSwatch" android:backgroundTint="#C9CBD6" />
                    <ImageView android:id="@+id/color_purple" style="@style/CsColorSwatch" android:backgroundTint="#D500F9" />
                    <ImageView android:id="@+id/color_red" style="@style/CsColorSwatch" android:backgroundTint="#FF3D00" />
                    <ImageView android:id="@+id/color_yellow" style="@style/CsColorSwatch" android:backgroundTint="#FFEA00" />
                    <ImageView android:id="@+id/color_white" style="@style/CsColorSwatch" android:backgroundTint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ CUSTOM IMPORT ══ -->
            <FrameLayout
                android:id="@+id/upload_zone"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cs_dashed_drop">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_upload"
                        app:tint="#C9CBD6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Drop or tap to import a PNG cursor"
                        android:textColor="#C9CBD6"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_import_png"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="Import PNG"
                    android:textAllCaps="true"
                    android:textColor="#E4E4EA"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_cs_ghost_button" />

                <Button
                    android:id="@+id/btn_export_cursor"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="Export"
                    android:textAllCaps="true"
                    android:textColor="#E4E4EA"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_cs_ghost_button" />
            </LinearLayout>

            <!-- ══ BOTTOM ACTIONS ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_save_cursor"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="APPLY"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:background="@drawable/bg_cs_primary_button" />

                <ImageButton
                    android:id="@+id/btn_favorite_cursor"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cs_ghost_button"
                    android:contentDescription="Favorite"
                    android:padding="14dp"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="#9CA3AF" />

                <Button
                    android:id="@+id/btn_reset_cursor"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="RESET"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:background="@drawable/bg_cs_danger_button" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
