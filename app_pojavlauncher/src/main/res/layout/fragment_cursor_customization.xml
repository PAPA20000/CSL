<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121214"
    android:animateLayoutChanges="true">

    <!-- ═══════════════════════════════════════ -->
    <!-- ✦ TOP BAR / HEADER                     -->
    <!-- ═══════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cursor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1C1C1E"
        android:paddingHorizontal="12dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/cursor_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_button_round"
            android:src="@drawable/ic_arrow_back_white"
            android:padding="10dp"
            app:tint="#39FF14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="CURSOR CUSTOMIZATION"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════ -->
    <!-- ✦ SCROLLABLE MAIN LAYOUT               -->
    <!-- ═══════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cursor_top_bar">

        <!-- Wrapped in ConstraintLayout to properly enforce maxWidth on large screens -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="620dp">

                <!-- ═══════════════════════════════════════ -->
                <!-- ✦ SECTION: CURSOR LIVE PREVIEW        -->
                <!-- ═══════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE PREVIEW"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cursor_preview_container"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@drawable/bg_cursor_preview"
                    android:layout_marginBottom="28dp">

                    <ImageView
                        android:id="@+id/cursor_preview_image"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_mouse_pointer"
                        android:padding="6dp"
                        android:background="@drawable/bg_preview_box"
                        android:contentDescription="Current cursor preview"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/cursor_preview_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEFAULT"
                        android:textColor="#39FF14"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_size_chip"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_margin="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/cursor_preview_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scale: 100% | Opacity: 100%"
                        android:textColor="#8E8E93"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_margin="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- ✦ SECTION: CURSOR STYLE SELECTOR       -->
                <!-- ═══════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURSOR STYLE"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="28dp"
                    android:weightSum="3">

                    <!-- Classic Style Card -->
                    <LinearLayout
                        android:id="@+id/style_classic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:background="@drawable/background_card_neon"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_mouse_pointer"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Classic"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Gamepad Style Card -->
                    <LinearLayout
                        android:id="@+id/style_gamepad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:background="@drawable/background_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_gamepad_pointer"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gamepad"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Custom Style Card -->
                    <LinearLayout
                        android:id="@+id/style_custom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:background="@drawable/background_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_upload"
                            app:tint="#39FF14"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Custom File"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- ✦ SECTION: CURSOR SIZE & POSITION      -->
                <!-- ═══════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURSOR SIZE &amp; POSITION"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="28dp">

                    <!-- Scale -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CURSOR SCALE"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"/>

                        <TextView
                            android:id="@+id/scale_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="#39FF14"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_cursor_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="6dp"
                        android:max="300"
                        android:progress="100"
                        android:progressTint="#39FF14"
                        android:thumbTint="#39FF14"
                        android:progressBackgroundTint="#2C2C2E"/>

                    <!-- Hotspot X -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="HOTSPOT X"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"/>

                        <TextView
                            android:id="@+id/hotspot_x_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 px"
                            android:textColor="#39FF14"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_hotspot_x"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="6dp"
                        android:max="128"
                        android:progress="0"
                        android:progressTint="#39FF14"
                        android:thumbTint="#39FF14"
                        android:progressBackgroundTint="#2C2C2E"/>

                    <!-- Hotspot Y -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="HOTSPOT Y"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"/>

                        <TextView
                            android:id="@+id/hotspot_y_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 px"
                            android:textColor="#39FF14"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_hotspot_y"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="6dp"
                        android:max="128"
                        android:progress="0"
                        android:progressTint="#39FF14"
                        android:thumbTint="#39FF14"
                        android:progressBackgroundTint="#2C2C2E"/>

                </LinearLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- ✦ SECTION: CURSOR GLOW & COLOR         -->
                <!-- ═══════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURSOR GLOW &amp; COLOR"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="28dp">

                    <!-- Glow Intensity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="GLOW INTENSITY"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"/>

                        <TextView
                            android:id="@+id/glow_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#39FF14"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_glow_strength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="6dp"
                        android:max="60"
                        android:progress="0"
                        android:progressTint="#39FF14"
                        android:thumbTint="#39FF14"
                        android:progressBackgroundTint="#2C2C2E"/>

                    <!-- Glow Opacity / Cursor Opacity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CURSOR OPACITY"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"/>

                        <TextView
                            android:id="@+id/opacity_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="#39FF14"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_cursor_opacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="6dp"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="#39FF14"
                        android:thumbTint="#39FF14"
                        android:progressBackgroundTint="#2C2C2E"/>

                    <!-- GLOW COLOR SELECTION -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GLOW COLOR PRESETS"
                        android:textColor="#8E8E93"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="12dp"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp"
                            android:gravity="center_vertical">

                            <!-- Green -->
                            <ImageView
                                android:id="@+id/color_green"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/bg_color_circle"
                                android:backgroundTint="#A6FF3D"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:padding="2dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="#000000"/>

                            <!-- Cyan -->
                            <ImageView
                                android:id="@+id/color_cyan"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/bg_color_circle"
                                android:backgroundTint="#00E5FF"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:padding="8dp"/>

                            <!-- Purple -->
                            <ImageView
                                android:id="@+id/color_purple"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/bg_color_circle"
                                android:backgroundTint="#D500F9"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:padding="8dp"/>

                            <!-- Red -->
                            <ImageView
                                android:id="@+id/color_red"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/bg_color_circle"
                                android:backgroundTint="#FF3D00"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:padding="8dp"/>

                            <!-- Yellow -->
                            <ImageView
                                android:id="@+id/color_yellow"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="16dp"
                                android:background="@drawable/bg_color_circle"
                                android:backgroundTint="#FFEA00"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:padding="8dp"/>

                            <!-- White -->
                            <ImageView
                                android:id="@+id/color_white"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_color_circle"
                                android:backgroundTint="#FFFFFF"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:padding="8dp"/>

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- ✦ SECTION: IMPORT &amp; EXPORT             -->
                <!-- ═══════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMPORT &amp; EXPORT"
                    android:textColor="#8E8E93"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="32dp">

                    <!-- Upload Zone -->
                    <LinearLayout
                        android:id="@+id/upload_zone"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/bg_dashed_border"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_upload"
                            app:tint="#39FF14"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to browse and upload image/GIF"
                            android:textColor="#8E8E93"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Import & Export Buttons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.kdt.mcgui.MineButton
                            android:id="@+id/btn_import_png"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_green_gradient_button"
                            android:text="IMPORT FILE"
                            android:textColor="#000000"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:stateListAnimator="@null"/>

                        <com.kdt.mcgui.MineButton
                            android:id="@+id/btn_export_cursor"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/background_card_neon"
                            android:text="EXPORT FILE"
                            android:textColor="#39FF14"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:stateListAnimator="@null"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- ═══════════════════════════════════════ -->
                <!-- ✦ ACTION BUTTONS (SAVE & RESET)        -->
                <!-- ═══════════════════════════════════════ -->
                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_save_cursor"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_save_button_neon"
                    android:text="SAVE CHANGES"
                    android:textColor="#000000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="12dp"/>

                <com.kdt.mcgui.MineButton
                    android:id="@+id/btn_reset_cursor"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_delete_button"
                    android:text="RESET TO DEFAULT"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:stateListAnimator="@null"
                    android:layout_marginBottom="20dp"/>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
