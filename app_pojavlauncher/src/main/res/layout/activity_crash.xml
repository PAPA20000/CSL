<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="16dp"
            android:background="#121212"
            android:elevation="6dp">

            <LinearLayout
                android:id="@+id/crash_back_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="12dp"
                android:paddingRight="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/accent_primary"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back"
                    android:textColor="@color/accent_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crash Report"
                    android:textColor="@color/text_primary_white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The game closed unexpectedly"
                    android:textColor="@color/text_secondary_light"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Error summary card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_settings_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Game Crashed"
                        android:textColor="@color/accent_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/crash_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="An unexpected error occurred while running the game."
                        android:textColor="@color/text_primary_white"
                        android:textSize="14sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Upload result card -->
                <LinearLayout
                    android:id="@+id/upload_result_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_settings_card"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/accent_primary"
                        android:contentDescription="Success" />

                    <TextView
                        android:id="@+id/upload_result_url"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="@color/text_primary_white"
                        android:textSize="13sp"
                        android:autoLink="web"
                        android:linksClickable="true"
                        android:breakStrategy="simple"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:layout_marginStart="10dp" />

                    <ImageButton
                        android:id="@+id/btn_copy_url"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_copy"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Copy link" />

                    <ImageButton
                        android:id="@+id/btn_share_url"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_menu_share"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Share link" />
                </LinearLayout>

                <!-- Log viewer card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_settings_card"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Full Log"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:layout_marginBottom="8dp" />

                    <ProgressBar
                        android:id="@+id/crash_loading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/crash_log_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#CFCFCF"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:scrollbars="vertical"
                        android:textIsSelectable="true" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Action bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:background="#121212"
            android:elevation="6dp">

            <Button
                android:id="@+id/btn_upload_log"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_save_button"
                android:text="Upload Log"
                android:textColor="#0D0D0D"
                android:textStyle="bold"
                android:textSize="13sp"
                android:drawableStart="@drawable/ic_upload"
                android:drawableTint="#0D0D0D" />

            <Button
                android:id="@+id/btn_copy_log"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_save_bar"
                android:text="Copy Log"
                android:textColor="@color/text_primary_white"
                android:textStyle="bold"
                android:textSize="13sp"
                android:drawableStart="@drawable/ic_copy"
                android:drawableTint="@color/text_primary_white" />

            <Button
                android:id="@+id/btn_home"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_save_bar"
                android:text="Home"
                android:textColor="@color/text_primary_white"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
