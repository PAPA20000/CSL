<?xml version="1.0" encoding="utf-8"?>
<!-- Modpack / Mod Search — premium glass redesign (user req).
     All view IDs preserved for SearchModFragment (R5). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cs_page_bg"
    android:orientation="vertical">

    <!-- ── HEADER (glass, back + title + search + filter) ── -->
    <LinearLayout
        android:id="@+id/mod_store_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_cs_header_bar"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- Row: back + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp">

            <ImageButton
                android:id="@+id/mod_store_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_cs_settings_row"
                android:contentDescription="@string/global_back"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#E4E4EA" />

            <TextView
                android:id="@+id/mod_store_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/minecraftia"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="BROWSE RESOURCES"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Row: search + filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_cs_input_field">

                <EditText
                    android:id="@+id/search_mod_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="Search mods..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="40dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6B7280"
                    android:textSize="13.5sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cs_search"
                    app:tint="#6B7280" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/search_mod_filter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_cs_settings_row"
                android:contentDescription="@string/browse_filter_cd"
                android:padding="8dp"
                android:src="@drawable/ic_filter"
                app:tint="#E4E4EA" />

        </LinearLayout>

    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/search_mod_progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:progressTint="#B39DDB"
        android:visibility="gone" />

    <!-- Mod list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_mod_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="24dp"
        android:overScrollMode="never"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none" />

    <!-- Status text -->
    <TextView
        android:id="@+id/search_mod_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="No results found."
        android:textColor="#9CA3AF"
        android:textSize="12.5sp"
        android:visibility="gone" />

</LinearLayout>
