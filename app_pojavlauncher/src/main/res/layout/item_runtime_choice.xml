<?xml version="1.0" encoding="utf-8"?>
<!-- One runtime choice card (reused 4x inside the wizard) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/runtime_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_runtime_card"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Version number block -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_deck_icon_tile">

        <TextView
            android:id="@+id/runtime_major_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-light"
            android:textColor="#F2F2F5"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="17" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/runtime_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F0F0F3"
                android:textSize="14.5sp"
                android:textStyle="bold"
                tools:text="Java 17" />

            <TextView
                android:id="@+id/runtime_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_runtime_chip_recommended"
                android:textColor="#D8C79A"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="RECOMMENDED"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/runtime_role_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#9C9CA8"
            android:textSize="11sp"
            tools:text="Minecraft 1.17 – 1.20.4" />
    </LinearLayout>

    <!-- Right-side state slot: check / spinner -->
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/runtime_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_check_circle"
            android:padding="5dp"
            android:src="@drawable/ic_check_small"
            android:visibility="gone"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/runtime_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#D8C79A"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

</LinearLayout>
