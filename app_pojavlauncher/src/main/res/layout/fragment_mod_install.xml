<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     CONTENT DETAIL / INSTALL — CS Premium redesign (Modrinth-style).
     Hero banner + stat chips + scroll-spy tabs + Install CTA.
     All legacy IDs preserved for ModInstallFragment.
     ═══════════════════════════════════════════════════════════════════ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cs_page_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/install_scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/_52sdp"
        android:layout_marginBottom="@dimen/_64sdp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingTop="@dimen/_14sdp"
            android:paddingBottom="@dimen/_12sdp">

            <!-- ══ HERO BANNER ══ -->
            <FrameLayout
                android:id="@+id/install_hero_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cs_glass_card"
                android:clipChildren="true">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:background="@drawable/bg_cs_hero_aura" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:padding="@dimen/_16sdp">

                    <FrameLayout
                        android:layout_width="@dimen/_78sdp"
                        android:layout_height="@dimen/_78sdp"
                        android:background="@drawable/bg_cs_icon_ring"
                        android:padding="2.5dp">

                        <ImageView
                            android:id="@+id/install_mod_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/background_image_rounded"
                            android:clipToOutline="true"
                            android:scaleType="centerCrop"
                            tools:src="@mipmap/ic_launcher_foreground" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/install_mod_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_19ssp"
                            android:textStyle="bold"
                            tools:text="Sodium" />

                        <TextView
                            android:id="@+id/install_mod_author"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#C9CBD6"
                            android:textSize="@dimen/_12ssp"
                            android:visibility="gone"
                            tools:text="by jellysquid3" />

                        <TextView
                            android:id="@+id/install_selected_version_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_24sdp"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:background="@drawable/bg_cs_chip_accent"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:textColor="#E4E4EA"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold"
                            tools:text="mc1.21-0.6.0" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ══ STATS CHIPS ══ -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/install_stats_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/install_stat_downloads"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:background="@drawable/bg_cs_glass_card_sm"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_16sdp"
                        android:paddingVertical="@dimen/_10sdp">

                        <TextView
                            android:id="@+id/install_stat_downloads_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_15ssp"
                            android:textStyle="bold"
                            tools:text="42M" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Downloads"
                            android:textColor="#6B7280"
                            android:textSize="@dimen/_9ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/install_stat_followers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:background="@drawable/bg_cs_glass_card_sm"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_16sdp"
                        android:paddingVertical="@dimen/_10sdp">

                        <TextView
                            android:id="@+id/install_stat_followers_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_15ssp"
                            android:textStyle="bold"
                            tools:text="4.2K" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Followers"
                            android:textColor="#6B7280"
                            android:textSize="@dimen/_9ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/install_stat_license"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cs_glass_card_sm"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_16sdp"
                        android:paddingVertical="@dimen/_10sdp">

                        <TextView
                            android:id="@+id/install_stat_license_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/_15ssp"
                            android:textStyle="bold"
                            tools:text="LGPL" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="License"
                            android:textColor="#6B7280"
                            android:textSize="@dimen/_9ssp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ══ SCROLL-SPY TABS ══ -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/install_tab_overview" style="@style/CsDetailTab" android:text="Overview" />
                    <TextView android:id="@+id/install_tab_details" style="@style/CsDetailTab" android:text="Details" />
                    <TextView android:id="@+id/install_tab_gallery" style="@style/CsDetailTab" android:text="Gallery" />
                    <TextView android:id="@+id/install_tab_deps" style="@style/CsDetailTab" android:text="Dependencies" />
                    <TextView android:id="@+id/install_tab_changelog" style="@style/CsDetailTab" android:text="Changelog" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ══ OVERVIEW ══ -->
            <LinearLayout
                android:id="@+id/install_about_section"
                style="@style/CsSectionCard"
                android:layout_marginTop="@dimen/_12sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:letterSpacing="0.18"
                    android:text="OVERVIEW"
                    android:textColor="#E4E4EA"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/install_full_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#B9BECC"
                    android:textSize="@dimen/_13ssp"
                    tools:text="Sodium is a modern rendering engine for Minecraft which greatly improves frame rates and reduces stuttering." />
            </LinearLayout>

            <!-- ══ DETAILS ══ -->
            <LinearLayout
                android:id="@+id/install_details_section"
                style="@style/CsSectionCard">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:letterSpacing="0.18"
                    android:text="DETAILS"
                    android:textColor="#E4E4EA"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/_8sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Version"
                        android:textColor="#9CA3AF"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/install_detail_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold"
                        tools:text="mc1.21-0.6.0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/install_detail_updated_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/_8sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Updated"
                        android:textColor="#9CA3AF"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/install_detail_updated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_12ssp"
                        tools:text="2026-07-20" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Source"
                        android:textColor="#9CA3AF"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/install_detail_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_12ssp"
                        tools:text="Modrinth" />
                </LinearLayout>

                <TextView
                    android:id="@+id/install_loaders_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Loaders"
                    android:textColor="#9CA3AF"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/install_loaders_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/install_mcversions_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Minecraft Versions"
                    android:textColor="#9CA3AF"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/install_mcversions_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/install_categories_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="Tags"
                    android:textColor="#9CA3AF"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/install_categories_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:orientation="horizontal" />

                <!-- Links (visibility-managed by Java) -->
                <LinearLayout
                    android:id="@+id/install_links_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/install_link_website"
                        style="@style/CsLinkRow"
                        android:text="🌐  Website" />

                    <TextView
                        android:id="@+id/install_link_source"
                        style="@style/CsLinkRow"
                        android:text="💻  Source Code" />

                    <TextView
                        android:id="@+id/install_link_issues"
                        style="@style/CsLinkRow"
                        android:text="🐛  Issue Tracker" />

                    <TextView
                        android:id="@+id/install_link_wiki"
                        style="@style/CsLinkRow"
                        android:text="📖  Wiki" />

                    <TextView
                        android:id="@+id/install_link_discord"
                        style="@style/CsLinkRow"
                        android:text="💬  Discord" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ GALLERY ══ -->
            <LinearLayout
                android:id="@+id/install_gallery_section"
                style="@style/CsSectionCard"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:letterSpacing="0.18"
                    android:text="GALLERY"
                    android:textColor="#E4E4EA"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/install_gallery_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_140sdp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/install_gallery_container"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ══ DEPENDENCIES ══ -->
            <LinearLayout
                android:id="@+id/install_deps_section"
                style="@style/CsSectionCard"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:letterSpacing="0.18"
                    android:text="DEPENDENCIES"
                    android:textColor="#E4E4EA"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/install_deps_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#B9BECC"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <!-- ══ CHANGELOG ══ -->
            <LinearLayout
                android:id="@+id/install_changelog_section"
                style="@style/CsSectionCard"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:letterSpacing="0.18"
                    android:text="CHANGELOG"
                    android:textColor="#E4E4EA"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/install_changelog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#B9BECC"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Top bar ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/install_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:layout_gravity="top"
        android:background="@drawable/bg_glass_header"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/padding_medium">

        <ImageButton
            android:id="@+id/install_back_button"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:background="@drawable/bg_cs_ghost_button"
            android:contentDescription="@string/global_back"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_arrow_back_white"
            app:tint="#E4E4EA" />

        <TextView
            android:id="@+id/install_topbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_15ssp"
            android:textStyle="bold"
            tools:text="Sodium" />
    </LinearLayout>

    <!-- ── Bottom Install CTA ──────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/install_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#0B0B0E"
        android:elevation="10dp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_12sdp">

        <Button
            android:id="@+id/install_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:background="@drawable/bg_cs_primary_button"
            android:letterSpacing="0.1"
            android:text="@string/mod_install_now"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold" />
    </FrameLayout>

</FrameLayout>
