<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     LOADER INSTALLER (Forge / NeoForge / OptiFine) — premium redo
     (Req: loader installer pages — cards, progress, buttons, states)
═════════════════════════════════════════════════════════════════ -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_browse_page">

    <ViewFlipper
        android:id="@+id/mod_dl_step_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inAnimation="@anim/slide_in_up">

        <!-- ═══════════ SCREEN 1: VERSION LIST ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_browse_header"
                android:elevation="6dp"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/loader_installer_eyebrow"
                    android:textColor="#7C7C88"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/title_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/forge_dl_select_version"
                    android:textColor="#F0F0F3"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/loader_installer_sub"
                    android:textColor="#9C9CA8"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/mod_dl_list_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#E4E4EA"
                    android:progressBackgroundTint="#23232B"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Retry card -->
            <LinearLayout
                android:id="@+id/mod_dl_retry_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_margin="20dp"
                android:background="@drawable/bg_install_section_card"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/modloader_dl_failed_to_load_list"
                    android:textColor="#E5A0A6"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/forge_installer_retry_button"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_install_cta_white"
                    android:stateListAnimator="@null"
                    android:text="@string/global_retry"
                    android:textAllCaps="true"
                    android:textColor="#0E0E11"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Version list -->
            <ExpandableListView
                android:id="@+id/mod_dl_expandable_version_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cacheColorHint="@android:color/transparent"
                android:childDivider="@android:color/transparent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:groupIndicator="@null"
                android:paddingTop="10dp"
                android:paddingBottom="20dp"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- ═══════════ SCREEN 2: READY TO INSTALL ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_browse_header"
                android:elevation="6dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <ImageButton
                    android:id="@+id/mod_dl_step2_back_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_browse_filter_btn"
                    android:contentDescription="@string/global_back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back_white"
                    app:tint="#E4E4EA" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/loader_installer_ready_title"
                    android:textColor="#F0F0F3"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Summary card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_install_hero_card"
                    android:padding="26dp">

                    <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_deck_icon_tile">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_download_trend"
                            app:tint="#E4E4EA" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/loader_installer_summary_title"
                        android:textColor="#F0F0F3"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/loader_installer_summary_sub"
                        android:textColor="#9C9CA8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/mod_dl_label_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_version_badge_accent"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="7dp"
                        android:textColor="#0E0E11"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Forge 47.2.0" />
                </LinearLayout>
            </LinearLayout>

            <!-- White CTA -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F2141419"
                android:elevation="12dp"
                android:paddingHorizontal="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="16dp">

                <Button
                    android:id="@+id/mod_dl_start_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_install_cta_white"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@null"
                    android:text="@string/loader_installer_start"
                    android:textAllCaps="true"
                    android:textColor="#0E0E11"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </ViewFlipper>
</androidx.constraintlayout.widget.ConstraintLayout>
