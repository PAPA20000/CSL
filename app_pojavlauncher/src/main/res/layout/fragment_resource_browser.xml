<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060A14"
    android:orientation="vertical"
    android:animateLayoutChanges="true">

    <!-- ═══ TOP HEADER ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_glass_header"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp">

        <View
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_neon_indicator"
            android:layout_marginEnd="14dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse Resources"
                android:textColor="#00E5FF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/resource_browser_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Install mods, resource packs, or shader packs"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ TABS ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tab_mods"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mods"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_dark"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_resourcepacks"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Resource Packs"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:background="@drawable/bg_chip_dark"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_shaderpacks"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Shaders"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:background="@drawable/bg_chip_dark"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ═══ IMPORT BUTTON ═══ -->
    <Button
        android:id="@+id/resource_import_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:text="Import from File"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_orange" />

    <!-- ═══ INSTALLED LIST ═══ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INSTALLED"
        android:textColor="#00FF41"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resource_installed_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp" />

    <!-- ═══ EMPTY STATE ═══ -->
    <TextView
        android:id="@+id/resource_empty_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No resources installed yet.\nImport from file to get started."
        android:textColor="#555555"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

    <!-- ═══ BOTTOM BAR ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/resource_skip_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Skip"
            android:textColor="#AAAAAA"
            android:background="@drawable/bg_glass_card_premium"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/resource_done_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_orange"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
