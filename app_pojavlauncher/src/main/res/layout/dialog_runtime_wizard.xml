<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     FIRST-LAUNCH RUNTIME WIZARD + distinct install sequence UI
     (Req: onboarding runtime wizard • runtime download design language)
═════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_install_page"
    android:paddingHorizontal="20dp"
    android:paddingTop="22dp"
    android:paddingBottom="18dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_java_cup" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/rw_eyebrow"
                android:textColor="#D8C79A"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rw_title"
                android:textColor="#F0F0F3"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/rw_sub"
        android:textColor="#9C9CA8"
        android:textSize="12sp" />

    <!-- Status strip (install sequence progress) -->
    <TextView
        android:id="@+id/rw_status_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_runtime_chip_neutral"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:textColor="#D8C79A"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Setting up runtimes (1/2) — keep the app open"
        tools:visibility="visible" />

    <!-- Cards (static 4: Java 8 / 17 / 21 / 25) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <include layout="@layout/item_runtime_choice" android:id="@+id/rw_card_8" />
        <include layout="@layout/item_runtime_choice" android:id="@+id/rw_card_17" />
        <include layout="@layout/item_runtime_choice" android:id="@+id/rw_card_21" />
        <include layout="@layout/item_runtime_choice" android:id="@+id/rw_card_25" />
    </LinearLayout>

    <!-- Footer actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/rw_btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_browse_filter_btn"
            android:paddingHorizontal="16dp"
            android:text="@string/rw_skip"
            android:textAllCaps="false"
            android:textColor="#9C9CA8"
            android:textSize="12.5sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <Button
            android:id="@+id/rw_btn_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.2"
            android:background="@drawable/bg_install_cta_white"
            android:text="@string/rw_download_cta_none"
            android:textAllCaps="false"
            android:textColor="#0E0E11"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
