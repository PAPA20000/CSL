<?xml version="1.0" encoding="utf-8"?>
<!--
     Settings category section card — landscape / horizontal launcher friendly
     IDs unchanged: category_title, category_count, settings_list_container
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="6dp"
    android:clickable="false"
    android:focusable="false"
    android:background="@drawable/bg_s4_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Header: compact for landscape height -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="28dp"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="6dp">

        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_s4_accent_bar" />

        <TextView
            android:id="@+id/category_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#C9CBD6"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/category_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_s4_value"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="26dp"
            android:minHeight="20dp"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="#E4E4EA"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Soft divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_s4_divider" />

    <!-- Settings rows (ID unchanged) -->
    <LinearLayout
        android:id="@+id/settings_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:divider="@drawable/bg_s4_row_divider"
        android:orientation="vertical"
        android:showDividers="middle" />

</LinearLayout>
