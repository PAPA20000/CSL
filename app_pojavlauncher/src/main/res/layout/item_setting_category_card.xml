<?xml version="1.0" encoding="utf-8"?>
<!-- ══════════════════════════════════════════════════════════════════
     Settings-HOME category card (hub grid edition — Phase 5, Req-6)
     Full redesign for the 2-column dashboard grid: luminous icon well,
     badge chip top-right, refined type scale, divider + chevron anchor.
     IDs are unchanged so the dashboard binder keeps working.
     ══════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="128dp"
    android:background="@drawable/bg_s4h_category_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header row: icon well + badge chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_s4h_icon_tile">

            <ImageView
                android:id="@+id/category_card_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_menu_settings"
                app:tint="#EDEDF2" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/category_card_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_s4h_badge_chip"
            android:letterSpacing="0.10"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp"
            android:textColor="#D9BBFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/category_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F3F3F7"
        android:textSize="14.5sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01" />

    <!-- Summary -->
    <TextView
        android:id="@+id/category_card_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#9A9AA6"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.15" />

    <!-- Footer anchor: hairline + chevron -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="0.8dp"
            android:layout_weight="1"
            android:background="#1EFFFFFF" />

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="#B9BBC4" />
    </LinearLayout>

</LinearLayout>
