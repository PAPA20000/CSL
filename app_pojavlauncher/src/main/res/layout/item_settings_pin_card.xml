<?xml version="1.0" encoding="utf-8"?>
<!-- PINNED SETTING CARD — Favorites / Recently Changed dashboard rail -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="196dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:minHeight="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_s4_card"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_s4h_icon_tile">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_s4h_icon_glow" />

        <ImageView
            android:id="@+id/pin_card_glyph"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            tools:src="@drawable/ic_csp_star_filled"
            app:tint="#EDEDF2" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pin_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F3F3F7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pin_card_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9A9AA6"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pin_card_remove"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_rb_close"
        app:tint="#8E8E9A"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Remove pin" />

</LinearLayout>
