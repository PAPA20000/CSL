<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     CURSOR STUDIO V2 — Phase 4
     Per-state cursor customization + editable rules engine.
     Top bar → tabs (States / Rules) → live preview + controls.
     ═══════════════════════════════════════════════════════════════════ -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cursor_studio_page">

    <!-- ── Top bar ── -->
    <LinearLayout
        android:id="@+id/studio_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_cursor_header"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <LinearLayout
                android:id="@+id/studio_back_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_cursor_back_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#E4E4EA" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/studio_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cursor_studio_title"
                    android:textColor="#FFFFFF"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/studio_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cursor_studio_subtitle"
                    android:textColor="#6B7280"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/studio_master_switch"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_cursor_chip"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="On"
                android:textColor="#E4E4EA"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tabs: States | Rules -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/studio_tab_states"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_cursor_btn_primary"
                android:gravity="center"
                android:text="@string/cursor_studio_states_tab"
                android:textColor="#0D0D0D"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/studio_tab_rules"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_cursor_btn_secondary"
                android:gravity="center"
                android:text="@string/cursor_studio_rules_tab"
                android:textColor="#E4E4EA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── STATES container ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/studio_states_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/studio_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="40dp">

            <!-- State chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/studio_state_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Live preview stage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_cursor_preview_frame"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/studio_preview_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cursor_preview"
                    android:textColor="#9CA3AF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_cursor_preview_stage">

                    <ImageView
                        android:id="@+id/studio_preview_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contentDescription="Cursor preview" />

                    <TextView
                        android:id="@+id/studio_preview_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:textColor="#6B7280"
                        android:textSize="10sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Editor controls (built programmatically into this container) -->
            <LinearLayout
                android:id="@+id/studio_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_cursor_panel"
                android:orientation="vertical"
                android:padding="12dp" />

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/studio_import_button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cursor_btn_primary"
                    android:gravity="center"
                    android:text="@string/cursor_studio_import"
                    android:textColor="#0D0D0D"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/studio_reset_button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_cursor_btn_secondary"
                    android:gravity="center"
                    android:text="@string/cursor_studio_reset"
                    android:textColor="#E4E4EA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/studio_save_button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_cursor_btn_danger"
                    android:gravity="center"
                    android:text="@string/cursor_studio_save"
                    android:textColor="#E4E4EA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── RULES container ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/studio_rules_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/studio_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cursor_studio_rules_hint"
                android:textColor="#6B7280"
                android:textSize="11.5sp" />

            <LinearLayout
                android:id="@+id/studio_rules_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/studio_rule_add"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_cursor_btn_primary"
                    android:gravity="center"
                    android:text="@string/cursor_rule_add"
                    android:textColor="#0D0D0D"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/studio_rule_reset"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_cursor_btn_secondary"
                    android:gravity="center"
                    android:text="@string/cursor_rule_reset"
                    android:textColor="#E4E4EA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
