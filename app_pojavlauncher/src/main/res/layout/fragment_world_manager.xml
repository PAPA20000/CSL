<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     WORLD MANAGER v2 — Mobile-first premium redesign
     • Compact header (52dp)
     • Collapsible storage summary (single row)
     • Inline search + sort row
     • Full-bleed RecyclerView with proper weight
     • Pinned bottom import bar
     All IDs preserved for WorldManagerFragment
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cs_page_bg"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         SECTION 1 — HEADER BAR (compact 52dp)
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_cs_header_bar"
        android:paddingHorizontal="10dp">

        <!-- Back button — left -->
        <LinearLayout
            android:id="@+id/world_back_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_cs_settings_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/cs_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="#E4E4EA" />
        </LinearLayout>

        <!-- Title block — center-left -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toStartOf="@id/_header_right_group"
            android:layout_toEndOf="@id/world_back_button"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/minecraftia"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="@string/cs_world_manager_title"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/world_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8B90A6"
                android:textSize="9.5sp"
                tools:text="Profile: my-profile" />
        </LinearLayout>

        <!-- Right group: count chip + refresh -->
        <LinearLayout
            android:id="@+id/_header_right_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/world_count_chip"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_cs_chip_accent"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="…"
                android:textColor="#E4E4EA"
                android:textSize="9.5sp"
                android:textStyle="bold"
                tools:text="6 worlds" />

            <LinearLayout
                android:id="@+id/world_refresh_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_cs_settings_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/world_refresh_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/cs_world_refresh"
                    android:src="@drawable/ic_cs_refresh"
                    app:tint="#E4E4EA" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         SECTION 2 — STORAGE CARD (compact single-band)
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_cs_glass_card"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- Top row: icon + label + used size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_cs_icon_well">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cs_storage"
                    app:tint="#B39DDB" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/minecraftia"
                    android:includeFontPadding="false"
                    android:text="@string/cs_world_storage_title"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/world_storage_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/cs_world_storage_loading"
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/world_storage_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E4E4EA"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="2.4 GB" />
        </LinearLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/world_storage_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_cs_world_storage_bar" />

        <!-- Free / Total row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/world_storage_free"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#6B7280"
                android:textSize="9sp"
                tools:text="48.2 GB free" />

            <TextView
                android:id="@+id/world_storage_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6B7280"
                android:textSize="9sp"
                tools:text="of 128 GB" />
        </LinearLayout>
    </LinearLayout>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         SECTION 3 — SEARCH BAR (slim 40dp)
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_cs_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cs_search"
            app:tint="#6B7280" />

        <EditText
            android:id="@+id/world_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/cs_world_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B7280"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         SECTION 4 — SORT CHIPS (single scroll row, compact)
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:overScrollMode="never"
        android:paddingHorizontal="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/world_sort_last_played"
                style="@style/CsSortChip"
                android:text="@string/cs_world_sort_last_played" />

            <TextView
                android:id="@+id/world_sort_name"
                style="@style/CsSortChip"
                android:layout_marginStart="6dp"
                android:text="@string/cs_world_sort_name" />

            <TextView
                android:id="@+id/world_sort_size"
                style="@style/CsSortChip"
                android:layout_marginStart="6dp"
                android:text="@string/cs_world_sort_size" />

            <TextView
                android:id="@+id/world_sort_version"
                style="@style/CsSortChip"
                android:layout_marginStart="6dp"
                android:text="@string/cs_world_sort_version" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         SECTION 5 — WORLD LIST (takes ALL remaining space)
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/world_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingHorizontal="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical"
            tools:itemCount="8"
            tools:listitem="@layout/item_world" />

        <!-- Loading state — centered in frame -->
        <LinearLayout
            android:id="@+id/world_loading_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="32dp">

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="#B39DDB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/cs_world_loading"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Empty state — centered in frame -->
        <LinearLayout
            android:id="@+id/world_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:alpha="0.5"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_worlds"
                app:tint="#6B7280" />

            <TextView
                android:id="@+id/world_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/minecraftia"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/cs_world_empty"
                android:textColor="#9CA3AF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/cs_world_empty_hint"
                android:textColor="#6B7280"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         SECTION 6 — BOTTOM IMPORT BAR (pinned, never scrolls away)
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F20D0D10"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/world_import_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cs_primary_button"
            android:letterSpacing="0.08"
            android:text="@string/cs_world_import"
            android:textAllCaps="true"
            android:textColor="#0D0D0D"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/world_datapack_hint_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cs_ghost_button"
            android:letterSpacing="0.08"
            android:text="@string/cs_world_open_folder"
            android:textAllCaps="true"
            android:textColor="#9CA3AF"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
