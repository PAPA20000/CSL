<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     WORLD MANAGER — Premium redesign (user req)
     Glass header + storage card + search pill + sort chips + grid list.
     All view IDs preserved for WorldManagerFragment (R5).
     ═══════════════════════════════════════════════════════════════════ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cs_page_bg"
    android:orientation="vertical">

    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@drawable/bg_cs_header_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <LinearLayout
            android:id="@+id/world_back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cs_settings_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/cs_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="#E4E4EA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/minecraftia"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="@string/cs_world_manager_title"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/world_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8B90A6"
                android:textSize="10.5sp"
                tools:text="Profile: my-profile" />
        </LinearLayout>

        <TextView
            android:id="@+id/world_count_chip"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_cs_chip_accent"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="…"
            android:textColor="#E4E4EA"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="6 worlds" />

        <LinearLayout
            android:id="@+id/world_refresh_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cs_settings_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <ImageView
                android:id="@+id/world_refresh_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/cs_world_refresh"
                android:src="@drawable/ic_cs_refresh"
                app:tint="#E4E4EA" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── CHROME (storage + search + sort) ───────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp">

        <!-- storage card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cs_glass_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_cs_icon_well">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cs_storage"
                        app:tint="#E4E4EA" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/minecraftia"
                        android:includeFontPadding="false"
                        android:text="@string/cs_world_storage_title"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/world_storage_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/cs_world_storage_loading"
                        android:textColor="#9CA3AF"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/world_storage_used"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E4E4EA"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="2.4 GB" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/world_storage_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_cs_world_storage_bar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/world_storage_free"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#6B7280"
                    android:textSize="10sp"
                    tools:text="48.2 GB free" />

                <TextView
                    android:id="@+id/world_storage_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#6B7280"
                    android:textSize="10sp"
                    tools:text="of 128 GB" />
            </LinearLayout>
        </LinearLayout>

        <!-- search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cs_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="13dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cs_search"
                app:tint="#6B7280" />

            <EditText
                android:id="@+id/world_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/cs_world_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- sort chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/world_sort_last_played" style="@style/CsSortChip" android:text="@string/cs_world_sort_last_played" />
                <TextView android:id="@+id/world_sort_name" style="@style/CsSortChip" android:text="@string/cs_world_sort_name" />
                <TextView android:id="@+id/world_sort_size" style="@style/CsSortChip" android:text="@string/cs_world_sort_size" />
                <TextView android:id="@+id/world_sort_version" style="@style/CsSortChip" android:text="@string/cs_world_sort_version" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ── LIST — real RecyclerView scrolling + recycling ─────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/world_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="12dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:id="@+id/world_loading_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="44dp">

            <ProgressBar
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminateTint="#B39DDB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/cs_world_loading"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/world_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="44dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.55"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_worlds"
                app:tint="#6B7280" />

            <TextView
                android:id="@+id/world_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/minecraftia"
                android:includeFontPadding="false"
                android:gravity="center"
                android:text="@string/cs_world_empty"
                android:textColor="#9CA3AF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/cs_world_empty_hint"
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ── IMPORT BAR ─────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F20D0D10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/world_import_button"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cs_primary_button"
            android:letterSpacing="0.08"
            android:text="@string/cs_world_import"
            android:textAllCaps="true"
            android:textColor="#0D0D0D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/world_datapack_hint_button"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cs_ghost_button"
            android:letterSpacing="0.08"
            android:text="@string/cs_world_open_folder"
            android:textAllCaps="true"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
