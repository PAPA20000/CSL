<?xml version="1.0" encoding="utf-8"?>
<!-- ════════════════════════════════════════════════════════════════
     DOWNLOAD DECK (ground-up redo — Req: progress bar redesign)
     Top-anchored floating banner. Icon tile + big tabular percentage,
     meta line, full-width luminous beam. NOT the old bottom pill.
═════════════════════════════════════════════════════════════════ -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/download_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_download_deck"
        android:elevation="12dp"
        android:paddingHorizontal="14dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        app:layout_constraintWidth_max="520dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Content icon tile (mod icon swaps in during mod downloads) -->
        <ImageView
            android:id="@+id/progress_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_deck_icon_tile"
            android:clipToOutline="true"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_download"
            android:tint="#E4E4EA"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/progress_horizontal_bar"
            tools:ignore="UseAppTint" />

        <!-- Task title -->
        <TextView
            android:id="@+id/progress_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:textColor="#F0F0F3"
            android:textSize="13.5sp"
            app:layout_constraintStart_toEndOf="@id/progress_icon"
            app:layout_constraintEnd_toStartOf="@id/progress_percentage_text"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Downloading Sodium" />

        <!-- Big tabular percentage — the design signature -->
        <TextView
            android:id="@+id/progress_percentage_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.02"
            android:textColor="#F2F2F5"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/progress_status_text"
            app:layout_constraintBottom_toBottomOf="@id/progress_meta_row"
            tools:text="42%" />

        <!-- Sub metric -->
        <TextView
            android:id="@+id/progress_detail_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:textColor="#9C9CA8"
            android:textSize="10.5sp"
            app:layout_constraintStart_toStartOf="@id/progress_status_text"
            app:layout_constraintEnd_toStartOf="@id/progress_percentage_text"
            app:layout_constraintTop_toBottomOf="@id/progress_status_text"
            tools:text="141 MB / 513 MB" />

        <!-- Meta row: speed • eta -->
        <LinearLayout
            android:id="@+id/progress_meta_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="@id/progress_status_text"
            app:layout_constraintEnd_toStartOf="@id/progress_percentage_text"
            app:layout_constraintTop_toBottomOf="@id/progress_detail_text">

            <TextView
                android:id="@+id/progress_speed_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:textColor="#DADDE5"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="2.5 MB/s"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/progress_eta_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.02"
                android:textColor="#7C7C88"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="• 1m 20s remaining"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Luminous full-width beam -->
        <ProgressBar
            android:id="@+id/progress_horizontal_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_beam"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progress_meta_row"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════════════════════════════════ -->
    <!-- ✦ LEGACY COMPATIBILITY VIEWS (HIDDEN)  -->
    <!-- ═══════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/progress_indicator_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.kdt.mcgui.PulseOrbitView
            android:id="@+id/pulse_orbit"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </FrameLayout>

    <com.kdt.mcgui.KineticProgressView
        android:id="@+id/kinetic_progress_legacy"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/progress_textview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/progress_flip_arrow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:id="@+id/progress_linear_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical">
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
