<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_profile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_profile_card"
    android:stateListAnimator="@animator/card_press_anim"
    android:clipChildren="true"
    android:clickable="true"
    android:focusable="true">

    <!-- Background Image fills entire card -->
    <ImageView
        android:id="@+id/img_profile_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Dark scrim over full card background -->
    <View
        android:id="@+id/img_profile_background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#70000000"
        android:visibility="gone" />

    <!-- Main content: vertical layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top area: horizontal layout with icon on left, text on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <!-- Profile Icon (small, left side) -->
            <ImageView
                android:id="@+id/img_profile_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_profile_icon_rounded" />

            <!-- Profile name and info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_profile_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCCCCC"
                    android:textSize="10sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginTop="1dp" />

                <TextView
                    android:id="@+id/tv_profile_mod_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_primary"
                    android:textSize="9sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginTop="1dp" />

                <TextView
                    android:id="@+id/tv_profile_ram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="9sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingBottom="8dp">

            <!-- Add to Home Screen -->
            <FrameLayout
                android:id="@+id/btn_profile_shortcut"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_browse_button"
                android:stateListAnimator="@animator/card_press_anim"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/shortcut_add_title">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shortcut_add"
                    android:tint="@color/premium_cyan" />
            </FrameLayout>

            <!-- Browse Resources Button -->
            <FrameLayout
                android:id="@+id/btn_profile_browse"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_browse_button"
                android:stateListAnimator="@animator/card_press_anim"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_browse_resources"
                    android:tint="#39FF14" />
            </FrameLayout>

            <!-- Play Button -->
            <FrameLayout
                android:id="@+id/btn_profile_play"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_play_button_green"
                android:stateListAnimator="@animator/card_press_anim"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="#121212" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
