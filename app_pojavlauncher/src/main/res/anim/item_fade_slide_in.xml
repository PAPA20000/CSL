<?xml version="1.0" encoding="utf-8"?>
<!-- Premium card entrance: fade + rise + micro overshoot settle -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="240" />
    <translate android:fromYDelta="18dp" android:toYDelta="0" android:duration="260" />
    <scale
        android:fromXScale="0.96" android:toXScale="1.0"
        android:fromYScale="0.96" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="260" />
</set>
