<?xml version="1.0" encoding="utf-8"?>
<!-- CSL v3 rebuilt animation — mobile-friendly, snappy, 60fps. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="true">
    <alpha android:duration="180" android:fromAlpha="1.0" android:toAlpha="0.0"
        android:interpolator="@android:interpolator/accelerate_quad" />
    <scale android:duration="180" android:fromXScale="1.0" android:toXScale="0.97"
        android:fromYScale="1.0" android:toYScale="0.97"
        android:pivotX="50%" android:pivotY="50%"
        android:interpolator="@android:interpolator/accelerate_quad" />
</set>