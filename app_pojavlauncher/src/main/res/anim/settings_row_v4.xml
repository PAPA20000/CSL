<?xml version="1.0" encoding="utf-8"?>
<!-- S4 settings row entrance — Phase-3: fast_out_slow_in glide, no overshoot -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:duration="280"
    android:startOffset="0">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <translate android:fromYDelta="16dp" android:toYDelta="0" />
    <scale android:fromXScale="0.97" android:toXScale="1.0"
        android:fromYScale="0.94" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="100%" />
</set>
